<?xml version="1.0" encoding="utf-8"?>
<!--
  Device admin policy set for the kiosk owner component. Minimal: device owner grants the
  lock-task / status-bar / keyguard capabilities used in STEP 7; no extra user-facing policies.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <disable-keyguard-features />
    </uses-policies>
</device-admin>

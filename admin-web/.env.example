# Copy to .env.local for local dev. Real values live in Vercel env vars, never in git.
# NEXT_PUBLIC_ prefix is FORBIDDEN on the service role / any secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_API_KEY=
# 32+ byte random hex used to sign the httpOnly session cookie.
SESSION_SECRET=
